# Contact form backend (Resend). If these are missing, the contact section
# gracefully degrades to a mailto link + copy-email button — no fake form.
# Get a key at https://resend.com/api-keys (free tier available).

# Required: Resend API key (server-side only — never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=

# Required: where contact-form messages are delivered
CONTACT_TO_EMAIL=satyam.katara1620@gmail.com

# Optional: verified sender address. Defaults to Resend's onboarding address
# (only delivers to the Resend account owner's email). For production, verify
# your own domain in Resend and set it here.
CONTACT_FROM_EMAIL=
